  m_Name: 
  m_EditorClassIdentifier: UnityEngine.UI::UnityEngine.UI.Text
  m_Material: {fileID: 0}
  m_Color: {r: 0.85, g: 0.85, b: 0.85, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_FontData:
    m_Font: {fileID: 10102, guid: 0000000000000000e000000000000000, type: 0}
    m_FontSize: 18
    m_FontStyle: 0
    m_BestFit: 0
    m_MinSize: 10
    m_MaxSize: 40
    m_Alignment: 4
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1
  m_Text: "\xA1Enhorabuena! Has superado con valent\xEDa la hacienda abandonada,
    derrotado a los enemigos en el camino, eludido a las patrullas policiales, documentado
    todos los indicios y desenterrado con profundo respeto y dignidad a Laura entre
    las ra\xEDces del \xC1rbol Viejo.\n\nHas cruzado la meta de la zona pericial
    asegurada.\n\n\"Tu incansable b\xFAsqueda de verdad y justicia abre camino hacia
    el siguiente cuadrante...\"\n\n\xA1PREPARANDO ACCESO AL NIVEL 4!"
